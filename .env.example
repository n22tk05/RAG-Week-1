# ==============================================================================
# Biến môi trường mẫu cho Minimal RAG Engine
# ==============================================================================

# 1. API Keys (Google Gemini hoặc OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# 2. Supabase Configuration (Bắt buộc cho Vector DB)
SUPABASE_URL=https://your-project-ref.supabase.co
# Sử dụng Service Role Key (khuyến nghị cho server) hoặc Anon Key có quyền insert/select bảng documents
SUPABASE_PRIVATE_KEY=your_supabase_service_role_or_anon_key_here

# 3. Server Configurationt 
PORT=5000
NODE_ENV=development
